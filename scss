// Пример простого миксина для центрирования блока
@mixin center-block() {
    display: flex;
    justify-content: center;
    align-items: center;
}

body {
    @include center-block();
}

// Использование переменной цвета
$primary-color: #007BFF;

a {
    color: $primary-color;
    &:hover { text-decoration: underline; }
}

// Добавление декоративных элементов
h1::before {
    content: "\2728"; /* Звёздочка */
    margin-right: 1em;
}
